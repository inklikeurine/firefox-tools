{
  "manifest_version": 2,
  "name": "__DISPLAY_NAME__",
  "version": "0.1.0",
  "description": "__DESCRIPTION__",
  "browser_specific_settings": {
    "gecko": {
      "id": "__ID__",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["storage"],
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["*://example.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_title": "__DISPLAY_NAME__",
    "default_popup": "popup.html"
  }
}
